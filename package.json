{
  "name": "marknice-wechat",
  "version": "0.6.14",
  "description": "Obsidian plugin: convert Markdown notes into WeChat Official Account layouts, copy with formatting intact, and publish directly to the draft box.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit --skipLibCheck && node esbuild.config.mjs production",
    "test": "node scripts/run-converter-tests.mjs"
  },
  "keywords": [
    "obsidian",
    "wechat",
    "markdown"
  ],
  "author": "Willmove",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.11.0",
    "esbuild": "^0.21.0",
    "happy-dom": "^20.11.2",
    "obsidian": "latest",
    "tslib": "^2.6.0",
    "typescript": "^5.4.0"
  },
  "dependencies": {
    "fflate": "^0.8.2",
    "marked": "^12.0.0",
    "mathjax-full": "^3.2.2"
  }
}
